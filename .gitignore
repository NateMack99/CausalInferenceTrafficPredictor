# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling caches
.ruff_cache/
.pytest_cache/

# Local data and generated results (see docs/data.md)
data/*
!data/*.sh
!data/chicago-traffic-segments.json
